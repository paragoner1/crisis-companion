[package]
name = "solana-sos"
version = "1.0.0"
edition = "2021"
authors = ["Paragoner <paragoner@solanasos.com>"]
description = "Voice-activated emergency response system for Solana Mobile - Reliability-first mobile safety app"
license = "Apache-2.0"
repository = "https://github.com/paragoner1/crisis-companion"
keywords = ["emergency", "voice", "solana", "mobile", "safety"]
categories = ["emergency", "voice-recognition", "blockchain"]

[lib]
name = "solana_sos"
crate-type = ["cdylib", "rlib"]

[features]
default = ["monitoring", "voice", "private", "audio"]
desktop = []
private = []
voice = ["vosk", "nnnoiseless", "cpal"]
sensors = ["accelerometer"]
monitoring = ["tracing", "tracing-subscriber"]
audio = ["rodio"]
android = ["jni", "jni-sys", "ndk", "ndk-sys"]

[dependencies]
# ===== CORE MOBILE DEPENDENCIES =====
tokio = { version = "1.35", features = ["rt-multi-thread", "macros", "time", "fs"] }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
anyhow = "1.0"
thiserror = "1.0"
log = "0.4"
env_logger = "0.10"

# ===== MOBILE DATABASE =====
rusqlite = { version = "0.29", features = ["bundled"] }

# ===== MOBILE SECURITY =====
ring = "0.17"
argon2 = "0.5"
aes-gcm = "0.10"

# ===== TIME & UTILITIES =====
chrono = { version = "0.4", features = ["serde"] }
uuid = { version = "1.0", features = ["v4", "serde"] }
config = "0.13"
clap = { version = "4.0", features = ["derive"] }

# ===== JNI & ANDROID INTEGRATION =====
jni = { version = "0.21", optional = true }
jni-sys = { version = "0.3", optional = true }
ndk = { version = "0.8", optional = true }
ndk-sys = { version = "0.5", optional = true }

# ===== VOICE RECOGNITION & AUDIO =====
vosk = { version = "0.3.1", optional = true }
nnnoiseless = { version = "0.5", optional = true }
cpal = { version = "0.15", optional = true }
rodio = { version = "0.17", optional = true }

# ===== SENSOR PROCESSING =====
accelerometer = { version = "0.12", optional = true }

# ===== HTTP & NETWORKING (Mobile-optimized) =====
reqwest = { version = "0.11", features = ["json", "rustls-tls"] }

# ===== UTILITY DEPENDENCIES =====
rand = "0.8"
sha2 = "0.10"

# ===== SOLANA & BLOCKCHAIN =====
solana-client = "1.17"
solana-sdk = "1.17"
spl-token = "4.0"
anchor-lang = "0.29"

# ===== MONITORING (Mobile-appropriate) =====
tracing = { version = "0.1", optional = true }
tracing-subscriber = { version = "0.3", features = ["env-filter"], optional = true }

# ===== ON-DEVICE AI (Security-focused) =====
ort = "2.0.0-rc.10"
ndarray = "0.15"
hex = "0.4"

[dev-dependencies]
criterion = "0.5"
tokio-test = "0.4"
tempfile = "3.8"

[[bin]]
name = "solana-sos"
path = "src/main.rs"

[[bin]]
name = "demo_test"
path = "src/bin/demo_test.rs"

# Add other bins here
